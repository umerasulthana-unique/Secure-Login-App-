<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Log In - Secure Login App</title>
  <link rel="stylesheet" href="/public/style.css">
</head>
<body>
  <div class="card">
    <h1>Log in</h1>

    <% if (typeof registered !== 'undefined' && registered) { %>
      <div class="success">Account created. You can log in now.</div>
    <% } %>

    <% if (errors && errors.length) { %>
      <div class="errors">
        <ul style="margin:0; padding-left: 18px;">
          <% errors.forEach(function(e) { %>
            <li><%= e.msg %></li>
          <% }); %>
        </ul>
      </div>
    <% } %>

    <form method="POST" action="/login" autocomplete="off">
      <label for="username">Username</label>
      <input type="text" id="username" name="username" value="<%= oldInput.username || '' %>" required>

      <label for="password">Password</label>
      <input type="password" id="password" name="password" required>

      <button type="submit">Log in</button>
    </form>

    <div class="footer-link">
      Don't have an account? <a href="/register">Register</a>
    </div>
  </div>
</body>
</html>
