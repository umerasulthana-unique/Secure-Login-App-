<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Register - Secure Login App</title>
  <link rel="stylesheet" href="/public/style.css">
</head>
<body>
  <div class="card">
    <h1>Create an account</h1>

    <% if (errors && errors.length) { %>
      <div class="errors">
        <ul style="margin:0; padding-left: 18px;">
          <% errors.forEach(function(e) { %>
            <li><%= e.msg %></li>
          <% }); %>
        </ul>
      </div>
    <% } %>

    <form method="POST" action="/register" autocomplete="off">
      <label for="username">Username</label>
      <input type="text" id="username" name="username" value="<%= oldInput.username || '' %>" required>

      <label for="email">Email</label>
      <input type="email" id="email" name="email" value="<%= oldInput.email || '' %>" required>

      <label for="password">Password</label>
      <input type="password" id="password" name="password" minlength="10" required>

      <label for="confirmPassword">Confirm password</label>
      <input type="password" id="confirmPassword" name="confirmPassword" minlength="10" required>

      <button type="submit">Sign up</button>
    </form>

    <div class="footer-link">
      Already have an account? <a href="/login">Log in</a>
    </div>
  </div>
</body>
</html>
