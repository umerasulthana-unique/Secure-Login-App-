<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Set Up Two-Factor Authentication</title>
  <link rel="stylesheet" href="/public/style.css">
</head>
<body>
  <div class="card">
    <h1>Set up 2FA</h1>
    <p style="font-size: 14px; color: #52606d;">
      Scan this QR code with an authenticator app (Google Authenticator, Authy, 1Password, etc.),
      then enter the 6-digit code it generates to confirm setup.
    </p>

    <% if (error) { %>
      <div class="errors"><%= error %></div>
    <% } %>

    <% if (qrDataUrl) { %>
      <div class="qr-wrap">
        <img src="<%= qrDataUrl %>" alt="2FA QR code" width="200" height="200">
      </div>
    <% } %>

    <span class="secret-code">Manual entry key: <%= secret %></span>

    <form method="POST" action="/2fa/setup" autocomplete="off">
      <label for="token">Enter the 6-digit code</label>
      <input type="text" id="token" name="token" inputmode="numeric" pattern="[0-9]*" maxlength="6" required autofocus>

      <button type="submit">Confirm & enable 2FA</button>
    </form>

    <div class="footer-link"><a href="/dashboard">Cancel</a></div>
  </div>
</body>
</html>
